{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mjs",
    "related": false
  },
  "mutate": [
    "frontend/src/**/*.{js,jsx}",
    "!frontend/src/main.jsx"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 5000,
  "reporters": [
    "json",
    "html",
    "progress-append-only"
  ],
  "jsonReporter": {
    "fileName": "reports/mutacao/frontend.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutacao/frontend.html"
  },
  "tempDirName": ".stryker-tmp-front",
  "ignorePatterns": [
    "backend/__testes__",
    "e2e",
    ".jest.json",
    ".vitest.json",
    "reports"
  ],
  "cleanTempDir": true,
  "disableBail": true
}