{
  "name": "clinica-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Clínica+ — sistema-alvo do TCC 2 (backend Node + frontend React)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start:backend": "npm start -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build:frontend": "npm run build -w frontend",
    "reset-db": "npm run reset-db -w backend"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^9.2.5",
    "jest": "30.5.2",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "7.3.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
